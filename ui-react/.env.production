# Production / Vercel build environment variables.
# In a container deployment, env-config.js (generated at startup by the Docker
# entrypoint) sets window.__MINT_CONFIG__, which takes precedence over these
# build-time fallbacks.
# On Vercel, public/env-config.js IS shipped (Vite copies public/ into dist/), so
# window.__MINT_CONFIG__ is always present. scripts/generate-env-config.mjs
# rewrites dist/env-config.js from the Vercel project env vars at build time
# (VERCEL is set) — set AUTH_CLIENT_ID=mint-vercel and AUTH_CALLBACK_ORIGIN there.
# The VITE_* values below only act as fallbacks when neither env-config.js nor
# those env vars are present.
VITE_HASURA_ENDPOINT=http://graphql.mint.local/v1/graphql
VITE_AUTH_SERVER=https://portals.tapis.io
VITE_AUTH_CLIENT_ID=mint-local
VITE_AUTH_REALM=
VITE_AUTH_PROVIDER=tapis
VITE_GOOGLE_MAPS_KEY=AIzaSyDf8bXwyV7v9whOpZl64SRVWKdE6yBbt2k
