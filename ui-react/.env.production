# Production / Vercel build environment variables.
# In a container deployment, env-config.js (generated at startup) sets
# window.__MINT_CONFIG__, which takes precedence over these build-time fallbacks.
# On Vercel preview builds there is no env-config.js, so these defaults apply and
# point the preview at the local MINT deployment (ingress on *.mint.local).
VITE_HASURA_ENDPOINT=http://graphql.mint.local/v1/graphql
VITE_AUTH_SERVER=https://portals.tapis.io
VITE_AUTH_CLIENT_ID=mint-local
VITE_AUTH_REALM=
VITE_AUTH_PROVIDER=tapis
VITE_GOOGLE_MAPS_KEY=AIzaSyDf8bXwyV7v9whOpZl64SRVWKdE6yBbt2k
