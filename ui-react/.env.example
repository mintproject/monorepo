# ui-react configuration — copy to .env and edit, then run `npm run config:local`.
#
# WHERE THESE APPLY
#
# The app reads window.__MINT_CONFIG__, never these variables directly. This
# file is an input to scripts/generate-env-config.mjs, which is the single
# source of truth for the config shape and renders __MINT_CONFIG__ in every
# context:
#
#   local dev   `npm run config:local` regenerates public/env-config.js from .env
#   container   docker/entrypoint.sh regenerates it at startup from the process env
#   Vercel      `npm run build` regenerates it from the project's env vars
#
# So for a deployment you set these as plain environment variables (Helm values,
# `docker run -e`, Vercel project settings) — you do not ship a .env.
#
# Each key also accepts a VITE_-prefixed name (VITE_HASURA_ENDPOINT works as
# well as HASURA_ENDPOINT). Beware: the VITE_ form is NOT what makes the value
# reach the app in dev — public/env-config.js is. The prefix exists only so the
# same names work in the src/ fallbacks, which fire solely when env-config.js is
# missing. An empty value is treated as unset and falls back to the default.
#
# `npm run config:local` sources this file with the shell, so quote any value
# that contains spaces: WELCOME_MESSAGE="Welcome to MINT".

# --- Required-ish (all have defaults; the defaults target *.mint.local) --------

# Hasura GraphQL endpoint. Default: http://graphql.mint.local/v1/graphql
# TACC's public one serves anonymous read-only queries: https://graphql.mint.tacc.utexas.edu/v1/graphql
HASURA_ENDPOINT=https://graphql.mint.tacc.utexas.edu/v1/graphql

# OAuth2 issuer base URL. Default: https://portals.tapis.io
AUTH_SERVER=https://portals.tapis.io

# OAuth2 client id. Default: mint-local
# The identity provider allows ONE callback URL per client, so each origin
# (localhost, a Vercel preview, mint.tacc.utexas.edu) needs its own client.
AUTH_CLIENT_ID=mint-local

# 'keycloak' or 'tapis'. Default: tapis
AUTH_PROVIDER=tapis

# Keycloak realm. Ignored when AUTH_PROVIDER=tapis. Default: empty
AUTH_REALM=

# --- Optional ----------------------------------------------------------------

# Google Maps JS API key, used by the region maps on the home page.
# Default: a shared development key committed in public/env-config.js.
GOOGLE_MAPS_KEY=

# CKAN REST API base, no /api suffix. Default: https://ckan.tacc.utexas.edu
# CKAN echoes CORS headers only for *.tacc.utexas.edu, localhost and 127.0.0.1.
DATA_CATALOG_API=https://ckan.tacc.utexas.edu

# Human-browsable CKAN UI, used as the datasets browse iframe src.
# Falls back to DATA_CATALOG_API when unset.
DATA_CATALOG_BROWSE_URL=https://ckan.tacc.utexas.edu

# Ensemble Manager REST API base. Omitted from __MINT_CONFIG__ when unset, and
# the thread pages check for that absence — leave it empty unless you are
# working on model execution.
ENSEMBLE_MANAGER_API=

# Overrides the OAuth2 callback origin. The callback URL is always
# <origin>/oauth2/callback; set this when the browser origin is not the origin
# registered with the IdP (Vercel per-deployment preview URLs). Omitted when unset.
AUTH_CALLBACK_ORIGIN=

# Regex source overriding the default preview-origin allowlist used to validate
# the OAuth2 return origin. Omitted when unset.
AUTH_PREVIEW_ORIGIN_ALLOWLIST=

# Heading on the home page. Default: "Welcome to MINT Model Catalog"
WELCOME_MESSAGE=
