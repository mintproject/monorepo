# Local development environment variables
# These are used by Vite as fallbacks when window.__MINT_CONFIG__ is not set.
# Defaults target the local MINT deployment (ingress on *.mint.local).
VITE_HASURA_ENDPOINT=http://graphql.mint.local/v1/graphql
VITE_AUTH_SERVER=https://portals.tapis.io
VITE_AUTH_CLIENT_ID=mint-local
VITE_AUTH_REALM=
VITE_AUTH_PROVIDER=tapis
