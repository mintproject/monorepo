{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.wolf/hooks/session-start.js\" ]; then node \"$CLAUDE_PROJECT_DIR/.wolf/hooks/session-start.js\"; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.wolf/hooks/pre-read.js\" ]; then node \"$CLAUDE_PROJECT_DIR/.wolf/hooks/pre-read.js\"; fi",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.wolf/hooks/pre-write.js\" ]; then node \"$CLAUDE_PROJECT_DIR/.wolf/hooks/pre-write.js\"; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.wolf/hooks/post-read.js\" ]; then node \"$CLAUDE_PROJECT_DIR/.wolf/hooks/post-read.js\"; fi",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.wolf/hooks/post-write.js\" ]; then node \"$CLAUDE_PROJECT_DIR/.wolf/hooks/post-write.js\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.wolf/hooks/stop.js\" ]; then node \"$CLAUDE_PROJECT_DIR/.wolf/hooks/stop.js\"; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
