# ui-react against the compose stack, host mode.
#
# The tracked `ui-react/public/env-config.js` already carries these values, so
# `npm run dev` needs none of this. Use the file only to edit them:
#
#   cp compose/ui-react.env ui-react/.env
#   cd ui-react && npm run config:local && npm run dev
#
# `npm run config:local` OVERWRITES the tracked `ui-react/public/env-config.js`.
# Restore it before you commit:
#
#   git checkout -- ui-react/public/env-config.js
#
# The container profile reads the same keys from the environment instead. See
# the `ui-react` service in `compose.yaml`. Keep the two in step.
#
# Every URL below is a HOST url. The browser resolves them, not a container, so
# a compose service name would not resolve.

# Hasura in this stack. The anonymous role serves the catalog before sign-in.
HASURA_ENDPOINT=http://localhost:8080/v1/graphql

# Tapis, tenant `portals`. `mint-localhost-3000` is registered for the callback
# http://localhost:3000/oauth2/callback. Tapis allows one callback for each
# client, so the dev server must stay on port 3000.
AUTH_SERVER=https://portals.tapis.io
AUTH_CLIENT_ID=mint-localhost-3000
AUTH_PROVIDER=tapis
AUTH_REALM=

# Ensemble Manager in this stack. It listens on 3000 in its container. Compose
# publishes it on 3001.
ENSEMBLE_MANAGER_API=http://localhost:3001/v1
EXECUTION_ENGINE=tapis

# CKAN stays remote. This stack runs no CKAN.
DATA_CATALOG_API=https://ckan.tacc.utexas.edu
DATA_CATALOG_BROWSE_URL=https://ckan.tacc.utexas.edu

# Co-branding: 'tacc' for the TACC + UT Austin strip, 'none' for no logos. The
# committed public/env-config.js sets 'tacc' so the branded chrome is visible
# while developing it.
BRANDING=tacc
